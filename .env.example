MONGO_URL=mongodb://localhost:27017
DB_NAME=ummu_ayman
JWT_SECRET=badilisha-iwe-ndefu-sana-na-siri
JWT_DAYS=90
TZ_NAME=Africa/Dar_es_Salaam
FIREBASE_CREDENTIALS=./firebase-service-account.json
LOW_STOCK_THRESHOLD=2
CLOSE_DAY_REMINDER=21:00
WEEKLY_REPORT_TIME=SUN 21:30

# Jina la muuzaji chini ya risiti (GET /me, risiti).
SIGNATURE_NAME=Ummu Ayman

# ── Picha ya daftari (POST /daily/{date}/scan) ───────────────────────────────
# AI_PROVIDER ndiye anayeanza, AI_FALLBACK ni chaguo la pili/la tatu
# (tenganisha kwa koma). Chaguo: gemini, groq, claude.
# Kubadilisha AI = kubadilisha hapa na kuwasha server upya. Usiweke funguo
# kwenye code wala git — weka `.env` pekee.
AI_PROVIDER=gemini
AI_FALLBACK=groq,claude
AI_TIMEOUT=45
SCAN_MAX_MB=6

# Gemini: ufunguo wa AI Studio (AIza... au AQ...). Model ya bure ya Novemba 2026:
# gemini-3.5-flash-lite (2.0/2.5 zimezimwa).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq: vision ya sasa ni qwen/qwen3.8-27b (Llama 4 Scout ilizimwa Julai 2026).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Claude (hiari, ya kulipia): claude-haiku-5-5 ndiyo ya bei ndogo.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
