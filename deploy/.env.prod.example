# Backend domain (what EC2/Caddy serves — e.g. api.voltwater.co.tz or just your EC2 IP)
DOMAIN=api.voltwater.co.tz

# Your Vercel frontend URL (used for CORS Access-Control-Allow-Origin)
FRONTEND_ORIGIN=https://voltwater.vercel.app

# GitHub Container Registry (set automatically by CI — owner of the repo)
GITHUB_REPOSITORY_OWNER=YOUR_GITHUB_USERNAME

# Docker image tag (set automatically by CI from git SHA)
IMAGE_TAG=latest

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DB=company_website

# App secrets
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
ADMIN_EMAIL=admin@voltwater.co.tz
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REVALIDATE_SECRET=CHANGE_ME_RANDOM_32_CHARS

# Site URL (used in emails/links)
SITE_URL=https://voltwater.vercel.app

# SMTP (optional — for contact form emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com
NOTIFY_EMAIL=info@voltwater.co.tz

# reCAPTCHA (optional)
RECAPTCHA_SECRET=

# Upload limit (MB)
MAX_UPLOAD_MB=5

# Backup retention
BACKUP_RETENTION_DAYS=14
