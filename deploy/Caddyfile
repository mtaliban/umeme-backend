{
    admin off
}

# API_DOMAIN ikiwekwa (mf. api.domain.co.tz) → HTTPS otomatiki.
# Ikikosekana → HTTP kwenye :80.
{$API_DOMAIN::80} {

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Device-Token"
        -Server
    }

    encode gzip zstd

    @options method OPTIONS
    respond @options 204

    # Njia zote zinaendwa kama zilivyo kwenye app (mf. /auth/pin, /home).
    # /api/... inakatwa ili app ifikie /auth/pin pia.
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy backend:8000
    }
}
